{
  "expo": {
    "name": "Gym Note",
    "slug": "mobileworkout",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mobileworkout",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080d1a"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080d1a"
      },
      "package": "com.gymnote.app",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ],
      "versionCode": 14
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidSettingsFix",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4d9fff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
